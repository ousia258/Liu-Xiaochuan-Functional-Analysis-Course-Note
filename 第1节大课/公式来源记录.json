    "id": "1.1_M03",
    "label": "欧氏距离",
    "latex": "\\begin{gathered}x=(x_1,\\ldots,x_d),\\quad y=(y_1,\\ldots,y_d)\\in\\mathbb R^d\\\\\\rho(x,y)=\\|x-y\\|_2=\\left(\\sum_{i=1}^{d}(x_i-y_i)^2\\right)^{1/2}\\end{gathered}",
    "frame": "1.1_B0198",
    "explanation": "这里是实向量，维数d固定且有限。",
    "status": "课堂板书与教材式(1.1.1)相互支持",
    "source_id": "M03",
